<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Angelo's Burger</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/User-inventory.css">    
</head>
<body>
    <div class="sidebar">
        <img src="/css/Angelo's_Burger.jpg" alt="Angelo's Burger Logo" id="logo">
        <h1 class="divider"></h1>
        <div class="menu-top">
            <div class="menu-item">
                <a href="/Dashboard/User-Page/POS">
                    <img src="https://cdn-icons-png.flaticon.com/512/8974/8974918.png" alt="POS" class="menu-icon">
                    POS
                </a>
            </div>
            <div class="menu-item active"> 
                <a href="/Dashboard/Admin-dashboard/Settings">
                    <img src="https://cdn-icons-png.flaticon.com/512/8229/8229337.png" alt="Inventory" class="menu-icon">
                    Inventory
                </a>
            </div>
        </div>

        <div class="sidebar-spacer"></div>
        
        <div class="menu-item">
            <a href="/Dashboard/User-dashboard/user-Settings">
                <img src="https://cdn-icons-png.flaticon.com/512/2099/2099058.png" alt="Settings" class="menu-icon">
                Settings
            </a>
        </div>
        <div class="logout-section">
            <button class="logout-btn">
                <img src="https://cdn-icons-png.flaticon.com/512/1286/1286853.png" alt="Logout" class="menu-icon">
                Logout
            </button>
        </div>
    </div>
    
    <div class="main-content">
        <div class="container">
            <h1 class="page-title">Inventory</h1>

            <div class="d-flex flex-wrap justify-content-between">
                <!-- Total Products -->
                <div class="stats-box">
                    <h5 class="total-p">Total Products</h5>
                    <h4 id="totalProducts"><%= stats.totalProducts || 0 %></h4>
                </div>
                <!-- In Stock -->
                <div class="stats-box">
                    <h5 class="In-S">In Stock</h5>
                    <h4 id="inStockCount" style="color: #28a745;"><%= stats.inStock || 0 %></h4>
                </div>
                <!-- Low Stock -->
                <div class="stats-box">
                    <h5 class="Low-S">Low Stock</h5>
                    <h4 id="lowStockCount" style="color: #ffc107;"><%= stats.lowStock || 0 %></h4>
                </div>
                <!-- Out of Stock -->
                <div class="stats-box">
                    <h5 class="Out-of-S">Out of Stock</h5>
                    <h4 id="outOfStockCount" style="color: #dc3545;"><%= stats.outOfStock || 0 %></h4>
                </div>
            </div>

            <div class="content-box6">
                <div class="d-flex align-items-center gap-2">
                    <!-- Dropdown Buttons -->
                    <div class="dropdown">
                        <button 
                            class="btn categories-btn dropdown-toggle" 
                            type="button" 
                            id="dropdownMenuButton1" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false"
                        >
                            Categories
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                            <li><a class="dropdown-item" href="#" data-category="all">All Categories</a></li>
                            <li><a class="dropdown-item" href="#" data-category="Bread">Bread</a></li>
                            <li><a class="dropdown-item" href="#" data-category="Meat">Meat</a></li>
                            <li><a class="dropdown-item" href="#" data-category="Poultry">Poultry</a></li>
                            <li><a class="dropdown-item" href="#" data-category="Dairy">Dairy</a></li>
                            <li><a class="dropdown-item" href="#" data-category="Drinks">Drinks</a></li>
                            <li><a class="dropdown-item" href="#" data-category="Hotdog">Hotdogs & Sausages</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Item Tables -->
            <div class="content-box5">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="color: #6a0dad; width: 35%;">Product Name</th>
                            <th style="color: #6a0dad; width: 20%;">Category</th>
                            <th style="color: #6a0dad; width: 20%;">Quantity</th>
                            <th style="color: #6a0dad; width: 25%;">Status</th>
                        </tr>
                    </thead>
                    <tbody id="itemsTable">
                        <% if (items && items.length > 0) { %>
                            <% items.forEach(item => { 
                                let statusClass = '';
                                let statusText = '';
                                const lowStockThresholdValue = lowStockThreshold || 5;
                                
                                // Determine status based on quantity
                                if (item.quantity === 0) {
                                    statusClass = 'status-outofstock';
                                    statusText = 'Out of Stock';
                                } else if (item.quantity <= lowStockThresholdValue) {
                                    statusClass = 'status-lowstock';
                                    statusText = 'Low Stock';
                                } else {
                                    statusClass = 'status-instock';
                                    statusText = 'In Stock';
                                }
                                
                                let categoryClass = '';
                                switch(item.category) {
                                    case 'Bread': 
                                        categoryClass = 'category-bread'; 
                                        break;
                                    case 'Meat': 
                                        categoryClass = 'category-meat'; 
                                        break;
                                    case 'Poultry':
                                        categoryClass = 'category-poultry';
                                        break;
                                    case 'Dairy':
                                        categoryClass = 'category-dairy';
                                        break;
                                    case 'Drinks': 
                                        categoryClass = 'category-drinks'; 
                                        break;
                                    case 'Hotdog':
                                        categoryClass = 'category-hotdog';
                                        break;
                                    default: 
                                        categoryClass = 'category-other';
                                }
                            %>
                            <tr data-id="<%= item._id %>" data-category="<%= item.category.toLowerCase() %>">
                                <!-- Product Name -->
                                <td class="product-name">
                                    <span class="item-name"><%= item.name %></span>
                                    <br>
                                    <small class="text-muted">ID: <%= item._id.toString().slice(-6) %></small>
                                </td>
                                
                                <!-- Category -->
                                <td>
                                    <span class="category-badge <%= categoryClass %>">
                                        <%= item.category %>
                                    </span>
                                </td>
                                
                                <!-- Quantity -->
                                <td class="quantity-cell">
                                    <%= item.quantity %>
                                </td>
                                
                                <!-- Status -->
                                <td>
                                    <span class="status-badge <%= statusClass %>">
                                        <%= statusText %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr class="no-items-row">
                                <td colspan="4" class="text-center py-4" style="color: gray; font-style: italic;">
                                    No items in inventory
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>
    
    <script src="/js/user-inventory.js"></script>
</body>
</html>